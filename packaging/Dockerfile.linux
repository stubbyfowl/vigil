# Proves Vigil on real Linux: runs every test, builds the standalone app, then launches that build.
#   docker build -f packaging/Dockerfile.linux -t vigil-linux .
#   docker run --rm vigil-linux
# To copy the Linux build out:
#   docker run --rm -v "$PWD/dist-linux:/out" vigil-linux cp -r dist/vigil /out/
FROM ubuntu:24.04
RUN apt-get update -qq && apt-get install -y -qq python3 python3-venv libpython3.12 make binutils g++ \
    libportaudio2 libegl1 libgl1 libopengl0 libglib2.0-0t64 libdbus-1-3 libfontconfig1 libfreetype6 libxkbcommon0 libgssapi-krb5-2 >/dev/null
WORKDIR /vigil
COPY backend/requirements.txt backend/requirements-dev.txt backend/requirements-voice.txt backend/
RUN python3 -m venv .venv && .venv/bin/pip install -q --default-timeout=180 --retries 10 -r backend/requirements-dev.txt -r backend/requirements-voice.txt
COPY . .
ENV QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software LANG=C.UTF-8
RUN .venv/bin/python scripts/get_voice_model.py && make native && .venv/bin/pyinstaller --noconfirm --log-level WARN packaging/vigil.spec
CMD ["bash", "-c", "make test && ./dist/vigil/vigil --check && uname -sm"]
